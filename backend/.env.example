# Copy to backend/.env and fill in. Never commit the real file.
SUPABASE_URL=
# The anon (public) key: reads run as the signed-in user, so RLS applies
SUPABASE_KEY=
# The service role key: only the backend uses it, to save targets and model_outputs.
# Without it /today still works but new targets are not saved.
SUPABASE_SERVICE_ROLE_KEY=
