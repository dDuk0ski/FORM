# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* vars into the app bundle at build time,
# so never put a secret here (no service role key, no third-party API keys).

# 1 = ML routes return the fixtures in src/mocks after 300 ms (no backend needed).
# 0 = call EXPO_PUBLIC_ML_URL for real. Unset behaves like 1.
EXPO_PUBLIC_USE_MOCKS=1

# Base URL of the FastAPI ML service (services/ml). Only used when EXPO_PUBLIC_USE_MOCKS=0.
EXPO_PUBLIC_ML_URL=http://127.0.0.1:8000

# Supabase project URL and anon (public) key. `supabase start` prints both for local dev.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
